//verificar que dia de la 
//semana nos encontramos
Algoritmo sin_titulo
	Definir dia Como Entero
	Escribir "1 lunes, 2 martes, 3 miercoles, 4 jueves, 5 viernes, 6 sabado 7 domingo"
	Escribir "ingrese el numero corresponidete a la dia"
	Leer dia
	Segun (dia) Hacer
		opcion 1:
			Imprimir "hoy es Lunes"
		opcion 2:
			Imprimir "hoy es Martes"
		opcion 3:
			Imprimir "hoy es Miercoles"
		opcion 4:
			Imprimir "hoy es Jueves"
		opcion 5:
			Imprimir "hoy es Viernes"
		opcion 6:
			Imprimir "hoy es Sabado"
		opcion 7:
			Imprimir "hoy es Domingo"
		De Otro Modo:
			Imprimir "No es una opcion valida"
	Fin Segun
	
FinAlgoritmo
