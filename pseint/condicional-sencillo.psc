//El sistema debe permitir al usuario visualizar otro numero
//El sistema debe permitir al usuario visualizar cual de los dos numeros es mayor
Algoritmo sin_titulo
	Definir n1, n2 Como Entero
	Escribir "Ingrese un numero"
	Leer n1
	Escribir "Ingrese un numero"
	Leer n2
	Si (n1 > n2) Entonces
		Imprimir n1, " Es mayor "
	SiNo // (n1 < n2) 
		Imprimir n2, " Es mayor "
	Fin Si
	
	
	
FinAlgoritmo
